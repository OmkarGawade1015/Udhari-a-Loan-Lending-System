# Copy these values into your shell environment before starting the app.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/udhari_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=udhari_app
DB_PASSWORD=
# Generate a unique signing secret (at least 32 bytes for HS256); do not commit it.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000
# Optional first-admin bootstrap; set both values only for a local demo.
UDHARI_ADMIN_EMAIL=
UDHARI_ADMIN_PASSWORD=
